{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/scene_plan",
  "title": "Scene Plan",
  "description": "Ordered scene list produced by the Scene Planner agent.",
  "type": "object",
  "required": ["version", "scenes"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "style_playbook": { "type": "string", "description": "Name of the active style playbook" },
    "timing_source": {
      "type": "string",
      "enum": ["estimated", "tts_actual"],
      "description": "Whether scene timing is based on script estimation or real TTS timestamps"
    },
    "timing_calibration_status": {
      "type": "string",
      "enum": ["pending", "calibrated", "exceeds_threshold", "rewind_required"],
      "description": "Status of TTS timing calibration"
    },
    "script_duration_seconds": { "type": "number", "minimum": 0 },
    "target_duration_seconds": { "type": "number", "minimum": 1 },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "description", "start_seconds", "end_seconds"],
        "properties": {
          "id": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["talking_head", "broll", "animation", "paper_collage", "character_scene", "diagram", "text_card", "transition", "generated", "screen_recording"]
          },
          "description": { "type": "string" },
          "paragraph_label": {
            "type": "string",
            "enum": ["viral_hook", "quick_intro", "main_story", "turning_point", "big_picture", "powerful_ending", "viral_hook+quick_intro", "big_picture+powerful_ending"],
            "description": "Which six-act paragraph this scene corresponds to"
          },
          "locked_camera": {
            "type": "boolean",
            "default": true,
            "description": "Camera is locked for the entire scene (no zoom/pan/tilt/rotation)"
          },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 },
          "script_section_id": { "type": "string" },
          "framing": { "type": "string" },
          "movement": { "type": "string" },
          "transition_in": { "type": "string" },
          "transition_out": { "type": "string" },
          "overlay_notes": { "type": "string" },
          "shot_language": {
            "type": "object",
            "description": "Structured cinematography vocabulary for this scene",
            "properties": {
              "shot_size": {
                "type": "string",
                "enum": ["extreme_wide", "wide", "medium_wide", "medium", "medium_close", "close_up", "extreme_close_up", "over_shoulder", "insert", "establishing"]
              },
              "camera_movement": {
                "type": "string",
                "enum": ["static", "pan_left", "pan_right", "tilt_up", "tilt_down", "dolly_in", "dolly_out", "tracking_left", "tracking_right", "crane_up", "crane_down", "handheld", "steadicam", "whip_pan", "orbital", "zoom_in", "zoom_out", "rack_focus"]
              },
              "lens_mm": { "type": "integer", "enum": [14, 24, 35, 50, 85, 135, 200] },
              "lighting_key": {
                "type": "string",
                "enum": ["high_key", "low_key", "natural", "golden_hour", "blue_hour", "tungsten_warm", "neon", "silhouette", "rim_lit", "volumetric", "overcast_soft"]
              },
              "depth_of_field": { "type": "string", "enum": ["shallow", "medium", "deep"] },
              "color_temperature": { "type": "string", "enum": ["cool", "neutral", "warm", "mixed"] }
            },
            "additionalProperties": false
          },
          "shot_intent": {
            "type": "string",
            "description": "WHY this shot exists — what purpose it serves in the video"
          },
          "narrative_role": {
            "type": "string",
            "enum": ["establish_context", "introduce_subject", "build_tension", "deliver_payload", "transition", "emotional_beat", "evidence", "comparison", "resolution", "call_to_action"],
            "description": "What role this scene plays in the narrative structure"
          },
          "information_role": {
            "type": "string",
            "description": "What the viewer learns or feels from this scene"
          },
          "hero_moment": {
            "type": "boolean",
            "default": false,
            "description": "True if this is the visual peak of the video — deserves extra attention"
          },
          "character_actions": {
            "type": "array",
            "description": "Character-specific acting beats for rigged character animation scenes",
            "items": {
              "type": "object",
              "required": ["character_id", "action_sequence"],
              "properties": {
                "character_id": { "type": "string" },
                "emotion": { "type": "string" },
                "action_sequence": {
                  "type": "array",
                  "items": { "type": "string" },
                  "minItems": 1
                },
                "dialogue": { "type": "string" },
                "target": { "type": "string" },
                "notes": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "texture_keywords": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Visual texture descriptors: grain, clean, anamorphic, gritty, ethereal, etc."
          },
          "required_assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "description": { "type": "string" },
                "source": { "type": "string", "enum": ["generate", "source", "provided", "record"] }
              },
              "required": ["type", "description", "source"]
            }
          },
          "beats": {
            "type": "array",
            "description": "Semantic beats inside this scene. Each beat expresses one complete visual idea, bound to a narration sentence.",
            "items": {
              "type": "object",
              "required": ["id", "sync_sentence", "semantic_family", "duration_seconds", "core_idea", "visual_metaphor"],
              "properties": {
                "id": { "type": "string" },
                "sync_sentence": { "type": "string", "description": "The narration sentence/beat this visual element syncs to" },
                "semantic_family": {
                  "type": "string",
                  "enum": ["drop", "rise", "shake", "pop", "slide", "grow", "pulse", "slap", "fade"]
                },
                "core_idea": {
                  "type": "string",
                  "description": "What this narration sentence essentially means — the distilled concept, not the literal words. Per Playbook: 抛弃字面，提炼含义，如：老龄化危机/巨大财富/经济崩溃."
                },
                "visual_metaphor": {
                  "type": "string",
                  "description": "The strongest symbolic graphic replacing the literal meaning. Per Playbook: 财富→金库/皇冠，时间→沙漏/钟表，技术→芯片/服务器. Must be a concrete visual, not a description of the literal subject."
                },
                "duration_seconds": { "type": "number", "minimum": 0 },
                "start_seconds": { "type": "number", "minimum": 0 },
                "end_seconds": { "type": "number", "minimum": 0 },
                "visual_idea": { "type": "string", "description": "One sentence describing what this beat shows" },
                "image_prompt": {
                  "type": "string",
                  "description": "Playbook-grade full image prompt for this beat (director's complete scene description): background, main subject, supporting elements with narrative relationships, typography, composition proportions, atmosphere, and negative prompt. Written in the style of Playbook prompt 2 — the model generates the blueprint directly from this. English only (bilingual-spec section 10)."
                },
                "elements": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "layer": { "type": "string", "enum": ["bg", "hero", "element", "decor"] },
                      "kind": { "type": "string", "enum": ["img", "css"] },
                      "data_class": {
                        "type": "string",
                        "enum": ["real_data", "real_content", "creative", "css"]
                      },
                      "data_source": { "type": "string" },
                      "description": { "type": "string" },
                      "box": {
                        "type": "array",
                        "items": { "type": "number" },
                        "minItems": 4,
                        "maxItems": 4,
                        "description": "[left, top, width, height] as percentages of the canvas (0-100). Planned position BEFORE generation; the image prompt translates this into layout wording. Compose places the element at this box."
                      },
                      "rot": {
                        "type": "number",
                        "description": "Rotation angle in degrees for compose placement (kept small, <3 for paper feel)."
                      },
                      "z": {
                        "type": "integer",
                        "description": "z-index stacking order for compose placement (bg=0, hero high, decor highest)."
                      },
                      "family": {
                        "type": "string",
                        "enum": ["slide", "drop", "slap", "pop", "unfold", "wipe", "mask_reveal", "rotate", "fade"],
                        "description": "Entrance animation per Playbook prompt 3. slide=paper slide in; drop=paper drop; slap=paper slap down; pop=soft pop (scale 0->1 with tiny bounce); unfold=paper unfold; wipe=simple wipe reveal; mask_reveal=mask/gradient reveal; rotate=micro rotation entrance (<3deg); fade=gradual fade in. NO fancy 3D rotation, NO dramatic effects."
                      },
                      "micro": {
                        "type": "string",
                        "enum": ["sway", "lift", "pulse", "breathe", "none"],
                        "description": "Living-paper micro motion per Playbook prompt 3. sway=2-5px displacement; lift=1-2deg rotation; pulse=1-2% scale; breathe=opacity ~5% / shadow breathing; none=static. All tiny, never noticeable displacement."
                      },
                      "sfx": {
                        "type": "string",
                        "enum": ["paper_slide", "tape_press", "stamp_thud", "string_zip", "pin_click", "paper_tap", "none"]
                      },
                      "text": { "type": "string" }
                    },
                    "required": ["layer", "kind", "data_class", "description"]
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
