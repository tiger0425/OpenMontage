{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "wrc_episode.schema.json",
  "title": "WRC 分集脚本（单集）",
  "description": "每集脚本 = 一个 JSON 文件。生成：LLM 按 script-prompt.md 输出；消费：脚本闸门人审 → 抽帧（#64）→ TTS 分段 → hyperframes 模板（#65）。",
  "type": "object",
  "required": ["episode"],
  "properties": {
    "episode": {
      "type": "object",
      "required": ["index", "total_episodes", "title", "hook_open", "hook_close", "scenes"],
      "properties": {
        "index": { "type": "integer", "minimum": 1, "description": "第几集（1 起）" },
        "total_episodes": { "type": "integer", "minimum": 1, "maximum": 3, "description": "本系列总集数（自适应 1~3）" },
        "title": { "type": "string", "description": "本集内部标题（抖音发布标题在成品包阶段另定，#67）" },
        "hook_open": { "type": "string", "description": "开场钩文案（与 s0 narration 呼应）" },
        "hook_close": { "type": "string", "description": "结尾追更钩文案" },
        "prev_tail": { "type": ["string", "null"], "description": "上一集结尾文案（非首集必填，承接用）" },
        "duration_estimate_s": { "type": "integer", "description": "整集预估时长（实际以 TTS 为准）" },
        "background": { "type": "string", "description": "背景视频文件名（默认 youtube_rally_vertical.mp4，来自背景库）" },
        "watermark": { "type": "string", "description": "右下角水印文案（默认 拉力冷知识）" },
        "scenes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 10,
          "items": { "$ref": "#/definitions/scene" }
        }
      }
    }
  },
  "definitions": {
    "hook_type": {
      "type": "string",
      "enum": ["open_conflict", "twist", "metaphor", "number", "contrast", "trust", "result", "follow"]
    },
    "visual": {
      "type": "object",
      "required": ["desc", "type"],
      "properties": {
        "type": { "enum": ["image", "clip"], "description": "image=静态抽帧；clip=源视频动态片段（动作幕优先）" },
        "desc": { "type": "string", "description": "画面内容中文关键词短语（画面里能看到什么）" },
        "asset_path": { "type": ["string", "null"], "description": "抽帧/截片产物文件名（#64 产出后回填，如 scene0_grid.jpg）" },
        "source_hint": { "type": ["string", "null"], "description": "源视频时间戳/段落提示，如 '~4:20 附近'" },
        "clip_duration_s": { "type": ["integer", "null"], "minimum": 6, "maximum": 10, "description": "clip 时长 6~10s（type=clip 时用，默认 8）" },
        "offset_hint": { "type": ["integer", "null"], "minimum": 0, "maximum": 100, "description": "幕内切换时机 0~100（默认按 visuals 顺序等分幕长）" }
      }
    },
    "display": {
      "type": "object",
      "description": "合成布局数据（见 template/README.md 与 episode-lower-display.json 示例）",
      "properties": {
        "layout": { "enum": ["split", "center", "ending"], "default": "center" },
        "badge": { "type": "string" },
        "question": { "type": "string" },
        "hook": { "type": "object", "properties": { "main": { "type": "string" }, "sub": { "type": "string" } } },
        "tag": { "type": "string" },
        "title": { "type": "object", "properties": { "main": { "type": "string" }, "highlight": { "type": "string" } } },
        "sub": { "type": "string" },
        "list": { "type": "array", "items": { "type": "object", "properties": { "emoji": { "type": "string" }, "text": { "type": "string" }, "badge": { "type": "string" }, "hot": { "type": "boolean" } } } },
        "numbers": { "type": "array", "items": { "type": "object", "properties": { "key": { "type": "string" }, "label": { "type": "string" }, "value": { "type": "number" }, "countup": { "type": "boolean" }, "highlight": { "type": "boolean" } } } },
        "vs": { "type": "object", "properties": { "before": { "type": "object", "properties": { "label": { "type": "string" }, "value": { "type": "string" } } }, "after": { "type": "object", "properties": { "label": { "type": "string" }, "value": { "type": "string" } } } } },
        "label": { "type": "string" },
        "punch": { "type": "string" },
        "cta": { "type": "string" },
        "extra_img": { "type": "string" }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "hook_type", "narration", "visuals"],
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]+$", "description": "幕编号 s0..sN（= 一个 TTS 配音段）" },
        "hook_type": { "$ref": "#/definitions/hook_type" },
        "hook_text": { "type": ["string", "null"], "description": "钩子机制简述，如 '评论区质疑→掀底裤承诺'" },
        "narration": { "type": "string", "description": "配音文案，60~110 字，口语化非读稿" },
        "audio_s": { "type": ["number", "null"], "description": "本幕配音实际时长（TTS 后回填，时间轴用）" },
        "visuals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/definitions/visual" }
        },
        "display": { "$ref": "#/definitions/display", "description": "合成布局数据（模板生成器 #65 消费；缺省时生成器按默认中心布局出最小版）" },
        "duration_estimate_s": { "type": "integer", "description": "本幕配音预估时长（实际以 TTS 生成时长回填）" }
      },
      "if": {
        "properties": { "id": { "const": "s0" } },
        "required": ["id"]
      },
      "then": {
        "properties": { "hook_type": { "const": "open_conflict" } }
      }
    }
  }
}
