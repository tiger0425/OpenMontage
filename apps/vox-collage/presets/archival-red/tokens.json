{
  "id": "archival-red",
  "name": "Archival Red (Classic VOX Documentary)",
  "description": "Standard documentary-collage visual system with archival tan paper, ink black, halftone gray, hot red emphasis, and mustard tag accents.",
  "palette": {
    "stage_tan": "#C9BB9C",
    "ink_black": "#1A1A1A",
    "halftone_gray": "#8C8C8C",
    "accent_red": "#B62E1F",
    "tag_mustard": "#D9A441",
    "paper_white": "#F7F5EE"
  },
  "typography": {
    "headline_font": "msyhbd.ttc, Impact, sans-serif",
    "stat_font": "msyhbd.ttc, Oswald, Impact, sans-serif",
    "annotation_font": "simsun.ttc, Courier Prime, monospace",
    "body_font": "msyh.ttc, Helvetica, sans-serif"
  },
  "components": {
    "cutout_keyline_px": 5,
    "cutout_offset_stroke_px": 6,
    "cutout_shadow": "0 15px 30px rgba(0,0,0,0.35)",
    "photo_skew_max_deg": 3.5,
    "torn_paper_edge_roughness": 4
  },
  "motion": {
    "camera_drift_pct": 2.0,
    "spring_overshoot": "back.out(1.7)",
    "headline_wipe_duration": 0.35
  }
}
