{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/asset_library_meta",
  "title": "Global Asset Library Metadata",
  "description": "Metadata for each asset stored in assets/shared_library/.",
  "type": "object",
  "required": ["version", "source_type", "tags", "license", "usage_count", "date_added", "file_type"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "source_type": {
      "type": "string",
      "enum": ["user_upload", "web_search", "purchased", "licensed", "project_preset"]
    },
    "source_url": { "type": "string" },
    "source_description": { "type": "string" },
    "source_provider": {
      "type": "string",
      "description": "Provider slug, e.g. polyhaven / ambientcg / wikimedia / loc."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "license": {
      "type": "string",
      "enum": [
        "public_domain",
        "cc0",
        "cc_by",
        "cc_by_sa",
        "no_known_restrictions",
        "rights_managed",
        "commercial",
        "unknown"
      ]
    },
    "license_url": {
      "type": "string",
      "description": "Link to the licence text or the item page where rights are stated."
    },
    "license_checked": {
      "type": "boolean",
      "description": "True when a human or the source API explicitly confirmed the licence."
    },
    "creator": { "type": "string" },
    "usage_count": { "type": "integer", "minimum": 0 },
    "first_used_project": { "type": "string" },
    "date_added": { "type": "string", "format": "date" },
    "file_type": { "type": "string" },
    "dimensions": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 2,
      "maxItems": 2
    }
  },
  "additionalProperties": false
}
