# dropped the pipeline's workflow JSONs from every `git add`.
/ComfyUI/

# HyperFrames generated workspace (repo-root npx output)
# Anchored for the same reason: unanchored, it also swallowed
# apps/vox-collage/template/hyperframes/generate_composition.py.
/hyperframes/

